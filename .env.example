# ==========================================
# FlowMesh Platform Configuration
# ==========================================

# Environment & General
ENVIRONMENT=development
LOG_LEVEL=info
APP_NAME=FlowMesh
APP_VERSION=0.1.0

# API / Control Plane
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=dev-flowmesh-secret-key-replace-in-production-at-least-32-chars
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=FlowMesh
PORT=3000

# PostgreSQL (System of Record)
POSTGRES_USER=flowmesh
POSTGRES_PASSWORD=flowmesh_secure_password
POSTGRES_DB=flowmesh
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://flowmesh:flowmesh_secure_password@localhost:5432/flowmesh

# NATS JetStream (Durable Event Bus)
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=flowmesh-cluster

# StateStore (Redis or RediForge)
# Set STATE_STORE_PROVIDER to "redis", "rediforge", or "memory"
STATE_STORE_PROVIDER=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Edge Agent Configuration
AGENT_ID=agent-local-dev
AGENT_ENROLLMENT_SECRET=flowmesh-agent-dev-token-secret
AGENT_CONTROL_PLANE_URL=http://localhost:8000/api/v1/agents/ws
AGENT_QUEUE_DB_PATH=./data/agent_queue.db

# OpenTelemetry / Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=flowmesh-platform
PROMETHEUS_PORT=9090
