{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Golden Signals & Gateway Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "API Gateway Request Throughput (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(flowmesh_http_requests_total[1m]))",
          "legendFormat": "Total RPS"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "Workflow Execution Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(flowmesh_run_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(flowmesh_run_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(flowmesh_run_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "HTTP Error Rate (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(flowmesh_http_requests_total{status=~\"5..\"}[1m])) / sum(rate(flowmesh_http_requests_total[1m])) * 100",
          "legendFormat": "5xx Error Rate %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 5,
      "title": "Workflow Execution & Reliability",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "id": 6,
      "title": "Workflow Runs by Outcome",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(flowmesh_runs_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 8 },
      "id": 7,
      "title": "Dead Letter Queue Backlog",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(flowmesh_dlq_size)",
          "legendFormat": "DLQ Messages"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 8 },
      "id": 8,
      "title": "Tripped Circuit Breakers",
      "type": "stat",
      "targets": [
        {
          "expr": "count(flowmesh_circuit_breaker_state == 2) or vector(0)",
          "legendFormat": "Open Breakers"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["flowmesh", "overview", "platform"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "FlowMesh - Platform Overview",
