  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Per-Workflow Execution Metrics",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "title": "Executions by Workflow ID",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(flowmesh_runs_total[5m])) by (workflow_id)",
          "legendFormat": "{{workflow_id}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "title": "Execution Latency by Workflow (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(flowmesh_run_duration_seconds_bucket[5m])) by (le, workflow_id))",
          "legendFormat": "{{workflow_id}} (p95)"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "title": "Failures by Workflow ID",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(flowmesh_runs_total{status=\"FAILED\"}[5m])) by (workflow_id)",
          "legendFormat": "{{workflow_id}} (FAILED)"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "title": "Edge Agent Dispatched Commands",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(flowmesh_agent_commands_total[5m])) by (agent_id, operation)",
          "legendFormat": "{{agent_id}}: {{operation}}"
        }
      ]
    }
  ],
  "refresh": "5s",
