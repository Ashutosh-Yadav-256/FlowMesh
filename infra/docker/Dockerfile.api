FROM python:3.12-slim as builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

FROM python:3.12-slim as runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY apps/api /app/apps/api
COPY packages /app/packages
COPY services /app/services
COPY connectors /app/connectors

ENV PYTHONPATH="/app/apps/api:/app/packages/ai-scripting:/app/packages/data-transform:/app/packages/auth:/app/packages/workflow-schema:/app/packages/state-store:/app/packages/connector-sdk:/app/packages/search-engine:/app/services/workflow-engine:/app/services/event-router:/app/services/incident-manager:/app/connectors:/app/packages:/app/services:/app"
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
